# ==============================================================================
# TeachLive - Production Environment Variables Example Template (.env.example)
# IMPORTANT: Never commit your actual production .env file with secrets to Git.
# ==============================================================================

# Core Django Settings
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=live-class-1.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://live-class-1.onrender.com

# Production Host & Reverse Proxy (Render auto-populates RENDER_EXTERNAL_HOSTNAME)
RENDER_EXTERNAL_HOSTNAME=live-class-1.onrender.com

# HTTPS & Security Settings (Auto-enabled when DEBUG=False)
SECURE_SSL_REDIRECT=True
DATABASE_SSL_REQUIRE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database Configuration
# For SQLite (default local development fallback):
# DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (Render production):
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Google OAuth 2.0 / OpenID Connect (Student Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://live-class-1.onrender.com/student/google/callback/

# LiveKit WebRTC Configuration (Audio, Video & Screen Sharing)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email Configuration (TeachLive Notifications & Reminders)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TeachLive <no-reply@teachlive.edu>

# Scheduling Limits (Minutes)
CLASS_EARLY_START_MINUTES=15
CLASS_EARLY_JOIN_MINUTES=10
MIN_CLASS_DURATION_MINUTES=5
MAX_CLASS_DURATION_MINUTES=360
