# Django Settings
SECRET_KEY=django-insecure-liveclass-super-secret-key-change-in-production-!@#$1234
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration
# For SQLite (default development):
# Leave DATABASE_URL empty or unset, or set to: sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (production):
# DATABASE_URL=postgresql://liveclass_user:liveclass_password@localhost:5432/liveclass_db

# CORS / CSRF Settings (if needed)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google OAuth 2.0 / OpenID Connect Settings (Student Login)
# Obtain credentials from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs):
# Authorized redirect URI: http://localhost:8000/student/google/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LiveKit WebRTC Configuration (Live Video, Audio & Screen Sharing)
# Obtain from LiveKit Cloud (https://cloud.livekit.io) or your local/self-hosted LiveKit Server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Email Configuration (TeachLive Notifications & Transactional Mail)
# In development, console backend is used if unset:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# In production with SMTP (e.g. Gmail, SendGrid, Amazon SES):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=TeachLive <no-reply@teachlive.edu>

